rules_version = '2';
// Anyone can view cars (QR code pages). Only the signed-in admin (Firebase Auth) can change them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cars/{carId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /history/{historyId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
