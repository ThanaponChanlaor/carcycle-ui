rules_version = '2';
// Anyone can view cars (QR code pages). Only the admin account can change them.
// Replace ADMIN_EMAIL with the same email as VITE_ADMIN_EMAIL before pasting into the console.
// "Signed in" alone is not enough: with Email/Password on, anyone with the public API key can sign up.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cars/{carId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ADMIN_EMAIL';
      match /history/{historyId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.email == 'ADMIN_EMAIL';
      }
    }
  }
}
